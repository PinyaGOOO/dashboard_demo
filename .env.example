# Runtime mode: demo never touches a real cluster; use live explicitly.
PROXMOX_MODE=demo
PROXMOX_CLUSTER_NAME=Proxmox VE

# Proxmox API connection. Copy these values to your process environment and
# replace the placeholders; never commit the real token value.
PROXMOX_HOST=pve.example.com
# Native Proxmox API uses 8006. Use 443 when an HTTPS reverse proxy exposes
# /api2/json on the standard TLS port.
PROXMOX_PORT=8006
PROXMOX_USER=dashboard-api@pve
PROXMOX_TOKEN_NAME=dashboard
PROXMOX_TOKEN_VALUE=replace-with-a-generated-api-token-secret

# TLS certificate verification is enabled by default. Set to false only for a
# trusted development cluster with a self-signed certificate.
PROXMOX_VERIFY_SSL=true

# Optional comma-separated Proxmox node names used by legacy integrations.
PROXMOX_HOSTS=node1,node2

# Web UI of each nested stand VM. The default result is https://VM_IP:8006/.
STAND_WEB_SCHEME=https
STAND_WEB_PORT=8006
# Optional override; {ip} is replaced with the VM address.
# STAND_WEB_URL_TEMPLATE=https://{ip}:8006/

# Bounded Proxmox concurrency (valid range: 1..12).
PROXMOX_CLONE_BATCH=6
PROXMOX_DEPLOY_WORKERS=6
PROXMOX_SNAPSHOT_BATCH=6
PROXMOX_ROLLBACK_BATCH=4
# Number of stands reset concurrently by the global rollback action (1-4).
PROXMOX_BULK_ROLLBACK_STANDS=1
# Parallel QGA readers used for recent nested Proxmox web activity.
PROXMOX_ACTIVITY_WORKERS=4
PROXMOX_DELETE_BATCH=6

# Guest-side interface configured by the bundled vklvikl Linux bootstrap.
PROXMOX_GUEST_INTERFACE=vmbr0
# Maximum wait after the one-time automatic VM reboot used as network fallback.
PROXMOX_NETWORK_READY_TIMEOUT=180

# Dashboard HTTP server. Keep 127.0.0.1 unless a protected reverse proxy is used.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# Required for mutating API calls and reading stored VM passwords when set.
# Generate a long random value.
DASHBOARD_ADMIN_TOKEN=replace-with-a-long-random-operator-token
